{
  "name": "@daronthedragon/skillsmith",
  "version": "0.1.0",
  "description": "Build agent skills that demonstrably change behavior: a spec, a linter that rejects skills that cannot work, and an eval harness that proves whether one did.",
  "type": "module",
  "bin": { "skillsmith": "./dist/index.js" },
  "files": ["dist", "skill"],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": ["agent", "skills", "claude-code", "prompt-engineering", "eval", "linter", "llm"],
  "license": "MIT",
  "engines": { "node": ">=20" },
  "devDependencies": { "@types/node": "^22.7.0", "tsx": "^4.19.0", "typescript": "^5.6.0" }
}
